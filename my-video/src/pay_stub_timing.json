    {
      "id": 11,
      "startSeconds": 49.017,
      "endSeconds": 53.805,
      "startFrame30fps": 1471,
      "endFrame30fps": 1614,
      "text": "same $3,000 salary can take home completely different amounts of money."
    },
    {
      "id": 12,
      "startSeconds": 54.357,
      "endSeconds": 56.87,
      "startFrame30fps": 1631,
      "endFrame30fps": 1706,
      "text": "Your pay stub is not a cookie-cutter template."
    },
    {
      "id": 13,
      "startSeconds": 57.143,
      "endSeconds": 58.865,
      "startFrame30fps": 1714,
      "endFrame30fps": 1766,
      "text": "It is a financial fingerprint."
    },
    {
      "id": 14,
      "startSeconds": 59.741,
      "endSeconds": 63.82,
      "startFrame30fps": 1792,
      "endFrame30fps": 1915,
      "text": "Take three workers at the same company, each earning $3,000 gross."
    },
    {
      "id": 15,
      "startSeconds": 64.331,
      "endSeconds": 66.649,
      "startFrame30fps": 1930,
      "endFrame30fps": 1999,
      "text": "Worker A takes home twenty-four hundred."
    },
    {
      "id": 16,
      "startSeconds": 67.061,
      "endSeconds": 69.232,
      "startFrame30fps": 2012,
      "endFrame30fps": 2077,
      "text": "Worker B takes home twenty-two hundred."
    },
    {
      "id": 17,
      "startSeconds": 69.629,
      "endSeconds": 72.04,
      "startFrame30fps": 2089,
      "endFrame30fps": 2161,
      "text": "Worker C takes home nineteen hundred."
    },
    {
      "id": 18,
      "startSeconds": 72.517,
      "endSeconds": 72.916,
      "startFrame30fps": 2176,
      "endFrame30fps": 2187,
      "text": "Why?"
    },
    {
      "id": 19,
      "startSeconds": 73.392,
      "endSeconds": 76.669,
      "startFrame30fps": 2202,
      "endFrame30fps": 2300,
      "text": "Because withholding elections, state taxes, and benefit"
