      "startSeconds": 171.051,
      "endSeconds": 175.319,
      "startFrame30fps": 5132,
      "endFrame30fps": 5260,
      "text": "much estimated tax to peel off your paycheck every single pay cycle."
    },
    {
      "id": 45,
      "startSeconds": 176.298,
      "endSeconds": 179.062,
      "startFrame30fps": 5289,
      "endFrame30fps": 5372,
      "text": "Think of federal withholding as an escrow account."
