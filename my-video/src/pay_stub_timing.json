      "id": 6,
      "startSeconds": 26.605,
      "endSeconds": 28.678,
      "startFrame30fps": 798,
      "endFrame30fps": 860,
      "text": "taken from you without your consent."
    },
    {
      "id": 7,
      "startSeconds": 29.467,
      "endSeconds": 33.543,
      "startFrame30fps": 884,
      "endFrame30fps": 1006,
      "text": "Today, we are putting a real American pay stub under the microscope."
    },
    {
      "id": 8,
      "startSeconds": 34.005,
      "endSeconds": 39.563,
      "startFrame30fps": 1020,
      "endFrame30fps": 1187,
      "text": "We are going to audit all $800 line by line, separating mandatory"
    },
    {
      "id": 9,
      "startSeconds": 39.565,
      "endSeconds": 43.732,
      "startFrame30fps": 1187,
      "endFrame30fps": 1312,
      "text": "government taxes from money that is actually building your personal wealth."
    },
    {
      "id": 10,
      "startSeconds": 44.772,
      "endSeconds": 49.016,
      "startFrame30fps": 1343,
      "endFrame30fps": 1470,
      "text": "Here is the first critical truth: two people earning the exact"
