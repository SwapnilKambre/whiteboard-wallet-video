    {
      "id": 2,
      "startSeconds": 7.59,
      "endSeconds": 12.846,
      "startFrame30fps": 228,
      "endFrame30fps": 385,
      "text": "But when you check your bank account, only $2,200 actually arrived."
    },
    {
      "id": 3,
      "startSeconds": 13.543,
      "endSeconds": 16.474,
      "startFrame30fps": 406,
      "endFrame30fps": 494,
      "text": "Where did that $800 gap disappear to?"
    },
    {
      "id": 4,
      "startSeconds": 17.402,
      "endSeconds": 21.514,
      "startFrame30fps": 522,
      "endFrame30fps": 645,
      "text": "To most people, that $800 feels like an unfair penalty."
    },
    {
      "id": 5,
      "startSeconds": 22.046,
      "endSeconds": 26.541,
      "startFrame30fps": 661,
      "endFrame30fps": 796,
      "text": "When payroll deductions feel like a black box, it feels like money is simply being"
    },
