    {
      "id": 20,
      "startSeconds": 76.669,
      "endSeconds": 78.586,
      "startFrame30fps": 2300,
      "endFrame30fps": 2358,
      "text": "choices change everything."
    },
    {
      "id": 21,
      "startSeconds": 79.708,
      "endSeconds": 82.357,
      "startFrame30fps": 2391,
      "endFrame30fps": 2471,
      "text": "Your paycheck is not a flat subscription fee."
    },
    {
      "id": 22,
      "startSeconds": 82.638,
      "endSeconds": 86.511,
      "startFrame30fps": 2479,
      "endFrame30fps": 2595,
      "text": "It is dynamic, governed by the federal government, state tax authorities,"
    },
    {
      "id": 23,
      "startSeconds": 86.698,
      "endSeconds": 90.621,
      "startFrame30fps": 2601,
      "endFrame30fps": 2719,
      "text": "and most importantly, the specific paperwork you filed with your employer."
    },
    {
      "id": 24,
      "startSeconds": 91.694,
      "endSeconds": 94.658,
      "startFrame30fps": 2751,
      "endFrame30fps": 2840,
      "text": "Every standard pay stub begins with gross pay."
    },
    {
      "id": 25,
      "startSeconds": 95.063,
      "endSeconds": 96.329,
      "startFrame30fps": 2852,
      "endFrame30fps": 2890,
      "text": "This sits at the very top."
    },
    {
      "id": 26,
      "startSeconds": 96.703,
      "endSeconds": 100.844,
      "startFrame30fps": 2901,
      "endFrame30fps": 3025,
      "text": "It represents your total agreed-upon earnings before taxes, retirement"
