    {
      "id": 27,
      "startSeconds": 100.845,
      "endSeconds": 103.687,
      "startFrame30fps": 3025,
      "endFrame30fps": 3111,
      "text": "contributions, or medical insurance are ever touched."
    },
    {
      "id": 28,
      "startSeconds": 104.614,
      "endSeconds": 108.753,
      "startFrame30fps": 3138,
      "endFrame30fps": 3263,
      "text": "Below gross pay lies a catch-all category called deductions."
    },
    {
      "id": 29,
      "startSeconds": 109.283,
      "endSeconds": 112.711,
      "startFrame30fps": 3278,
      "endFrame30fps": 3381,
      "text": "This single word creates massive psychological confusion because it"
    },
    {
      "id": 30,
      "startSeconds": 112.711,
      "endSeconds": 117.501,
      "startFrame30fps": 3381,
      "endFrame30fps": 3525,
      "text": "lumps together money lost to taxes with money saved into your own future wealth."
    },
    {
      "id": 31,
      "startSeconds": 118.035,
      "endSeconds": 123.075,
      "startFrame30fps": 3541,
      "endFrame30fps": 3692,
      "text": "To read your pay stub like a professional auditor, you must divide the eight hundred"
    },
    {
      "id": 32,
      "startSeconds": 123.08,
      "endSeconds": 128.626,
      "startFrame30fps": 3692,
      "endFrame30fps": 3859,
      "text": "dollar gap into two distinct buckets: statutory taxes you owe the government"
    },
    {
      "id": 33,
      "startSeconds": 128.916,
      "endSeconds": 131.915,
      "startFrame30fps": 3867,
      "endFrame30fps": 3957,
      "text": "and pre-tax benefits that belong to you."
    },
    {
      "id": 34,
      "startSeconds": 132.956,
      "endSeconds": 138.526,
      "startFrame30fps": 3989,
      "endFrame30fps": 4156,
      "text": "Line item number one, federal income tax withholding, subtracting two hundred"
    },
    {
      "id": 35,
      "startSeconds": 138.526,
      "endSeconds": 140.212,
      "startFrame30fps": 4156,
      "endFrame30fps": 4206,
      "text": "and eighty dollars and fifty cents."
    },
    {
      "id": 36,
      "startSeconds": 140.714,
      "endSeconds": 143.053,
      "startFrame30fps": 4221,
      "endFrame30fps": 4292,
      "text": "This is not your final tax bill."
    },
    {
      "id": 37,
      "startSeconds": 143.345,
      "endSeconds": 147.947,
      "startFrame30fps": 4300,
      "endFrame30fps": 4438,
      "text": "It is an estimated prepayment sent directly to the United States Treasury."
    },
    {
      "id": 38,
      "startSeconds": 148.938,
      "endSeconds": 151.742,
      "startFrame30fps": 4468,
      "endFrame30fps": 4552,
      "text": "Your employer does not know your final tax rate."
    },
    {
      "id": 39,
      "startSeconds": 152.095,
      "endSeconds": 155.555,
      "startFrame30fps": 4563,
      "endFrame30fps": 4667,
      "text": "They do not know about your spouse's income, your stock dividends,"
    },
