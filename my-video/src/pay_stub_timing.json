      "id": 50,
      "startSeconds": 192.972,
      "endSeconds": 194.706,
      "startFrame30fps": 5789,
      "endFrame30fps": 5841,
      "text": "not free money from the government."
    },
    {
      "id": 51,
      "startSeconds": 194.978,
      "endSeconds": 198.96,
      "startFrame30fps": 5849,
      "endFrame30fps": 5969,
      "text": "That is an interest-free loan you accidentally gave the IRS."
    },
    {
      "id": 52,
      "startSeconds": 199.477,
      "endSeconds": 203.531,
      "startFrame30fps": 5984,
      "endFrame30fps": 6106,
      "text": "Dialing in your W-4 keeps that cash in your wallet every month."
