      "id": 40,
      "startSeconds": 155.595,
      "endSeconds": 157.374,
      "startFrame30fps": 4668,
      "endFrame30fps": 4721,
      "text": "or your freelance side hustle."
    },
    {
      "id": 41,
      "startSeconds": 157.779,
      "endSeconds": 161.346,
      "startFrame30fps": 4733,
      "endFrame30fps": 4840,
      "text": "They are only calculating an estimate based on your salary."
    },
    {
      "id": 42,
      "startSeconds": 162.358,
      "endSeconds": 166.74,
      "startFrame30fps": 4871,
      "endFrame30fps": 5002,
      "text": "That estimate is driven entirely by IRS Form W-4."
    },
    {
      "id": 43,
      "startSeconds": 167.132,
      "endSeconds": 171.048,
      "startFrame30fps": 5014,
      "endFrame30fps": 5131,
      "text": "The elections you made on that form tell payroll software exactly how"
